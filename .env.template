# Environment Configuration
NODE_ENV="development" # Options: 'development', 'production'
PORT="3081"            # The port your server will listen on
HOST="localhost"       # Hostname for the server

# CORS Settings
CORS_ORIGIN="http://localhost:*" # Allowed CORS origin, adjust as necessary

# Rate Limiting
# Effective window: 15 * 60 * WINDOW_MS ms (e.g. WINDOW_MS=1000 → 15 minutes)
# Requests from 127.0.0.1 (admin-api) are not rate-limited
COMMON_RATE_LIMIT_WINDOW_MS=1000
COMMON_RATE_LIMIT_MAX_REQUESTS=1000

# DB
POSTGRES_USER="POSTGRES_USER"
POSTGRES_PASSWORD="POSTGRES_PASSWORD"
POSTGRES_PORT="1234"
POSTGRES_DB="db_name"
POSTGRES_HOST="db_host"

# Application config
APP_CONFIG_DOMAIN="" # Defailt domain for links, ex. my-app-domain.com (optional)
